{
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "unused": "knip",
    "dedup": "npx -y jscpd .",
    "outdated": "npx -y npm-check-updates",
    "upgrade": "npx -y npm-check-updates -u && npm install",
    "housekeeping": "npm run outdated; npm audit; npm run unused; npm run dedup; npm run lint",
    "prepare": "lefthook install"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.14",
    "typescript": "^7",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "lefthook@2.1.14": true
  }
}
