{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  // Strategy: start from EVERY stable rule ("preset": "all") and switch off only what
  // does not apply to this project or was decided against. New Biome rules therefore
  // arrive enabled by default, and every exception below carries its reason.

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    // src/components/ui — vendored shadcn components, kept byte-identical to the registry
    // so re-adding them produces clean diffs.
    // files — anonymized IBKR statements used as test fixtures.
    // src/stats/lib/strategies — strategy detector vendored from optionslab, kept identical
    // to the source for re-syncs, guarded by its own spec.
    "includes": ["**", "!src/components/ui", "!files", "!src/stats/lib/strategies"]
  },

  "formatter": {
    "useEditorconfig": true,
    // Biome's maximum. Long JSX lines and tables stay on one line.
    "lineWidth": 320
  },

  "css": {
    // Tailwind v4 @theme / @apply / @custom-variant in src/index.css
    "parser": { "tailwindDirectives": true }
  },

  "linter": {
    "domains": {
      "react": "all",
      "project": "all",
      "test": "all"
    },
    "rules": {
      "preset": "all",

      "complexity": {
        // Defaults are too tight (50 lines, complexity 15, 4 params); relaxed but still
        // forcing a split once a function stops fitting in a reader's head.
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 80, "skipBlankLines": true } },
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 20 } },
        "useMaxParams": { "level": "error", "options": { "max": 5 } }
      },

      "correctness": {
        // Solid / Qwik rules — not our framework
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        // Meant for native Node ESM; Vite resolves extensionless imports
        "useImportExtensions": "off"
      },

      "performance": {
        // Solid / Next.js rules — not our framework
        "useSolidForComponent": "off",
        "noImgElement": "off",
        // Inline handlers like onClick={() => ...} are fine; useCallback everywhere is premature optimization
        "noJsxPropsBind": "off"
      },

      "security": {
        // Only false positives (CSS selectors, long Ukrainian sentences); the app handles no secrets
        "noSecrets": "off"
      },

      "suspicious": {
        // Solid rule, it forbids React's className
        "noReactSpecificProps": "off"
      },

      "style": {
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 400, "skipBlankLines": true } },
        // Data fields are snake_case (open_basis, realized_uah, ...) on purpose — decided against renaming
        "useNamingConvention": "off",
        // Ternary is the normal JSX idiom for conditional rendering
        "noTernary": "off",
        // i18n rule; the UI is Ukrainian-only with literal text
        "noJsxLiterals": "off",
        "useNumericSeparators": "off",
        // Files read top-down: exported function first, its helpers below
        "useExportsLast": "off"
      },

      // Experimental rules picked explicitly (the preset does not include nursery)
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUnsafePlusOperands": "error",
        "useExhaustiveSwitchCases": "error",
        "useNullishCoalescing": "error",
        "noUselessTypeConversion": "error",
        "noLoopFunc": "error",
        "noExcessiveNestedCallbacks": "error",
        "noUnsafeTypeAssertion": "error",
        "useSortedClasses": "error"
      }
    }
  },

  "overrides": [
    {
      // Tests and test helpers: long describe blocks, literal expected numbers and
      // realistic identifiers are the point here; they run in Node.
      "includes": ["**/*.test.ts", "src/lib/fixture.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noMagicNumbers": "off"
          },
          "nursery": {
            "noExcessiveNestedCallbacks": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      // Statistics are an optional module: the app renders StatsSection from statement-cards.tsx
      // and must not depend on anything else in src/stats, so stats can change or be removed freely.
      "includes": ["src/**", "!src/stats/**", "!src/components/cards/statement-cards.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": { "level": "error", "options": { "patterns": [{ "group": ["@/stats/**", "**/stats/**"], "message": "The app must not depend on src/stats, only statement-cards.tsx renders StatsSection." }] } }
          }
        }
      }
    },
    {
      // Command line scripts run in Node and print their progress
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Vite requires a default export and runs in Node
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" },
          "correctness": { "noNodejsModules": "off" }
        }
      }
    }
  ]
}
